# LLM backend: anthropic | openai | heuristic
MESHGUARD_LLM__PROVIDER=anthropic
MESHGUARD_LLM__MODEL=claude-opus-5-5
MESHGUARD_LLM__EFFORT=medium
MESHGUARD_LLM__LANGUAGE=Russian
# Credentials are read by the Anthropic SDK itself
# ANTHROPIC_API_KEY=

# Local OpenAI-compatible server (Ollama, vLLM): logs never leave the perimeter
# MESHGUARD_LLM__PROVIDER=openai
# MESHGUARD_LLM__MODEL=qwen3:14b
# MESHGUARD_LLM__BASE_URL=http://localhost:11434/v1

# Response policy overrides
# MESHGUARD_POLICY__MIN_CONFIDENCE=0.7
# MESHGUARD_POLICY__CRITICAL_SERVICES=["gateway","auth"]
